# Production API configuration
REACT_APP_API_BASE_URL=
REACT_APP_GOOGLE_CLIENT_ID=YOUR_ACTUAL_GOOGLE_CLIENT_ID
REACT_APP_GOOGLE_API_KEY=YOUR_ACTUAL_GOOGLE_API_KEY

# Cloudflare Worker for AI services
REACT_APP_CLOUDFLARE_WORKER_URL=https://wedding-ai-worker.your-subdomain.workers.dev

# Feature flags
REACT_APP_ENABLE_AI_FEATURES=true
REACT_APP_ENABLE_GOOGLE_INTEGRATION=true
GENERATE_SOURCEMAP=false
CI=false
REACT_APP_BACKEND_URL=https://shehnai.replit.app
BUILD_PATH=build
PUBLIC_URL=/
INLINE_RUNTIME_CHUNK=false