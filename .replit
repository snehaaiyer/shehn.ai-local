modules = ["python-3.12", "web", "nodejs-20"]
run = "cd react-frontend && npm install && HOST=0.0.0.0 PORT=5000 BROWSER=none npm start"

[nix]
channel = "stable-25_05"
packages = ["bash", "geckodriver", "libxcrypt"]

[deployment]
run = ["sh", "-c", "python simple_unified_server.py"]
build = ["sh", "-c", "cd react-frontend && npm install --legacy-peer-deps && npm run build"]

[workflows]
runButton = "Clean Wedding App Start"

