modules = ["python-3.12", "web", "nodejs-20"]
run = "node index.js"

[nix]
channel = "stable-25_05"
packages = ["bash", "geckodriver", "libxcrypt"]

[deployment]
run = ["sh", "-c", "node index.js"]

[workflows]
runButton = "Start Full Wedding App"

[[workflows.workflow]]
name = "Run Wedding App with NocoDB"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python simple_unified_server.py"

[[workflows.workflow]]
name = "Start All Wedding Services"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python start_all_services.py"

[[workflows.workflow]]
name = "Start React Frontend"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && npm start"

[[workflows.workflow]]
name = "Start React Frontend"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && chmod +x start-react-replit.sh && ./start-react-replit.sh"

[[workflows.workflow]]
name = "Start Full Wedding App"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "chmod +x start_react_with_backend.sh && ./start_react_with_backend.sh"

[[workflows.workflow]]
name = "React Frontend Only"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && npm install && HOST=0.0.0.0 PORT=3000 BROWSER=none npm start"

[[ports]]
localPort = 5000
externalPort = 80
