modules = ["python-3.12", "web", "nodejs-20"]
run = "node index.js"

[nix]
channel = "stable-25_05"
packages = ["bash", "geckodriver", "libxcrypt"]

[deployment]
run = ["sh", "-c", "node index.js"]

[workflows]
runButton = "Start All Wedding Services"

[[workflows.workflow]]
name = "Run Wedding App with NocoDB"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python simple_unified_server.py"

[[workflows.workflow]]
name = "Start All Wedding Services"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python start_all_services.py"

[[ports]]
localPort = 5000
externalPort = 80
