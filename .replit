modules = ["python-3.12", "web", "nodejs-20"]
run = "cd react-frontend && npm install && HOST=0.0.0.0 PORT=3000 BROWSER=none npm start"

[nix]
channel = "stable-25_05"
packages = ["bash", "geckodriver", "libxcrypt"]

[deployment]
run = ["sh", "-c", "python unified_wedding_server.py"]
build = ["sh", "-c", "cd react-frontend && npm install --legacy-peer-deps && npm run build:production"]

[workflows]
runButton = "Full Stack Production"

[[workflows.workflow]]
name = "Start Wedding App"
author = 37053864
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python unified_wedding_server.py"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && npm install --legacy-peer-deps && HOST=0.0.0.0 PORT=3000 BROWSER=none npm start"

[[workflows.workflow]]
name = "Backend Only"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python unified_wedding_server.py"

[[workflows.workflow]]
name = "Frontend Only"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && npm install --legacy-peer-deps && HOST=0.0.0.0 PORT=3000 BROWSER=none npm start"

[[workflows.workflow]]
name = "Clean Install"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && rm -rf node_modules package-lock.json && npm cache clean --force && npm install --legacy-peer-deps"

[[workflows.workflow]]
name = "React App Port 3000 Clean"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && rm -rf node_modules/.cache"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && npm install --legacy-peer-deps"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && HOST=0.0.0.0 PORT=3000 BROWSER=none npm start"

[[workflows.workflow]]
name = "Start on Port 3000"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && rm -rf node_modules/.cache"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && npm install --legacy-peer-deps"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && HOST=0.0.0.0 PORT=3000 BROWSER=none npm start"

[[workflows.workflow]]
name = "Start Ollama"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "export OLLAMA_HOST=0.0.0.0:11434"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "export OLLAMA_ORIGINS=*"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "ollama serve"

[[workflows.workflow]]
name = "Start Full Stack"
author = 37053864
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python unified_wedding_server.py"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && npm install --legacy-peer-deps && HOST=0.0.0.0 PORT=3000 BROWSER=none npm start"

[[workflows.workflow]]
name = "Start Full Stack"
author = 37053864
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python unified_wedding_server.py"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && npm install --legacy-peer-deps && HOST=0.0.0.0 PORT=3000 BROWSER=none npm start"

[[workflows.workflow]]
name = "Unified App Only"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python unified_wedding_server.py"

[[workflows.workflow]]
name = "Full Stack Production"
author = 37053864
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python unified_wedding_server.py"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && npm install --legacy-peer-deps && HOST=0.0.0.0 PORT=3000 BROWSER=none npm start"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[agent]
expertMode = true
