modules = ["python-3.12", "web", "nodejs-20"]
run = "node index.js"

[nix]
channel = "stable-25_05"
packages = ["bash", "geckodriver", "libxcrypt"]

[deployment]
run = ["sh", "-c", "node index.js"]

[workflows]
runButton = "React Frontend Only"

[[workflows.workflow]]
name = "Run Wedding App with NocoDB"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python simple_unified_server.py"

[[workflows.workflow]]
name = "Start All Wedding Services"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python start_all_services.py"

[[workflows.workflow]]
name = "Start React Frontend"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && npm start"

[[workflows.workflow]]
name = "Start React Frontend"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && chmod +x start-react-replit.sh && ./start-react-replit.sh"

[[workflows.workflow]]
name = "Start Full Wedding App"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "chmod +x start_react_with_backend.sh && ./start_react_with_backend.sh"

[[workflows.workflow]]
name = "React Frontend Only"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && npm install && HOST=0.0.0.0 PORT=5000 BROWSER=none npm start"

[[workflows.workflow]]
name = "Start React Frontend Only"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && npm install && HOST=0.0.0.0 PORT=3000 BROWSER=none npm start"

[[workflows.workflow]]
name = "Enhanced Vendor Selection"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python enhanced_vendor_selection_api.py"

[[workflows.workflow]]
name = "Run Intelligent Vendor System"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python vendor_recommendations_api.py"

[[workflows.workflow]]
name = "Full Wedding System"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python enhanced_vendor_selection_api.py"

[[workflows.workflow]]
name = "Backend Services Only"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python simple_unified_server.py"

[[workflows.workflow]]
name = "Test Vendor Search Integration"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python enhanced_vendor_selection_api.py &"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 3"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python test_vendor_search_integration.py"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80
