modules = ["python-3.12", "web", "nodejs-20"]
run = "cd react-frontend && npm install && HOST=0.0.0.0 PORT=3000 BROWSER=none npm start"

[nix]
channel = "stable-25_05"
packages = ["bash", "geckodriver", "libxcrypt"]

[deployment]
run = ["sh", "-c", "python unified_wedding_server.py"]
build = ["sh", "-c", "cd react-frontend && npm install --legacy-peer-deps && npm run build"]

[workflows]
runButton = "React App Port 3000 Clean"

[[workflows.workflow]]
name = "Start Wedding App"
author = 37053864
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python unified_wedding_server.py"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && npm install --legacy-peer-deps && HOST=0.0.0.0 PORT=3000 BROWSER=none npm start"

[[workflows.workflow]]
name = "Backend Only"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python unified_wedding_server.py"

[[workflows.workflow]]
name = "Frontend Only"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && npm install --legacy-peer-deps && HOST=0.0.0.0 PORT=3000 BROWSER=none npm start"

[[workflows.workflow]]
name = "Clean Install"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-frontend && rm -rf node_modules package-lock.json && npm cache clean --force && npm install --legacy-peer-deps"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8001
externalPort = 8001
