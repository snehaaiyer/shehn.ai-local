modules = ["python-3.12", "web", "nodejs-20"]
run = "cd react-frontend && npm install && HOST=0.0.0.0 PORT=5000 BROWSER=none npm start"

[nix]
channel = "stable-25_05"
packages = ["bash", "geckodriver", "libxcrypt"]

[deployment]
run = ["sh", "-c", "cd react-frontend && npm start"]
build = ["sh", "-c", "cd react-frontend && npm install && npm run build"]

[workflows]
runButton = "Wedding App - Working"

[[workflows.workflow]]
name = "Run Wedding App with NocoDB"
author = 37053864
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python simple_unified_server.py"

